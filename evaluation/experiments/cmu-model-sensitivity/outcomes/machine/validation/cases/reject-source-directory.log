Usage: node --import tsx evaluation/corpus/model-sensitivity-cli.ts freeze --source PINNED_CMU --archive ORIGINAL_DEVELOPMENT --identity PINNED_IDENTITY_TS --identity-report PINNED_REPORT_JSON --out NEW_FREEZE.json
