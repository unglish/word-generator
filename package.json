{
  "name": "@unglish/word-generator",
  "version": "0.6.0",
  "IDGAFversion": "u",
  "description": "A simple generator for creating unglish words.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "vitest run",
    "test:perf": "vitest run --config vitest.perf.config.ts --reporter=verbose",
    "test:quality": "vitest run --config vitest.quality.config.ts",
    "test:watch": "vitest",
    "analyze:common-words": "node --import tsx scripts/common-word-coverage.ts",
    "audit:gap-spellings": "node --import tsx scripts/gap-spelling-audit.ts",
    "analyze:phonemes": "node scripts/analyze-cmu-phonemes.mjs",
    "analyze:phoneme-length": "node --import tsx scripts/phoneme-length-dist.ts",
    "analyze:trigrams": "node scripts/analyze-cmu-trigrams.mjs",
    "audit:trace": "node scripts/trace-audit.mjs",
    "build:cmu-phonemes": "node scripts/build-cmu-phoneme-baseline.mjs",
    "demo:sync-cmu-baselines": "node scripts/sync-demo-cmu-baselines.mjs",
    "demo:check-cmu-baselines": "node scripts/sync-demo-cmu-baselines.mjs --check",
    "demo:check-worker-sync": "node scripts/check-demo-worker-sync.mjs",
    "prepublishOnly": "npm run build && npm run demo:check-worker-sync",
    "lint": "eslint src/**/*.ts evaluation/review/**/*.ts demo/review/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "dev": "concurrently \"vite\" \"tsc --watch\"",
    "build": "npm run review:typecheck && tsc && vite build && node scripts/inject-build-info.js && npm run copy-worker && npm run copy-demo-assets",
    "preview": "vite preview",
    "copy-worker": "cp dist-demo/unglish-worker.js demo/",
    "copy-demo-assets": "cp demo/commonWordsWorker.js demo/statsWorker.js demo/matchWorker.js demo/duplicateWorker.js demo/realwords.js demo/index.js demo/cmuBaselines.js dist-demo/ 2>/dev/null || true",
    "review:freeze": "node --env-file-if-exists=.env.local --import tsx evaluation/review/cli.ts freeze",
    "review:import": "node --env-file-if-exists=.env.local --import tsx evaluation/review/cli.ts import",
    "review:export": "node --env-file-if-exists=.env.local --import tsx evaluation/review/cli.ts export",
    "review:report": "node --env-file-if-exists=.env.local --import tsx evaluation/review/cli.ts report",
    "review:typecheck": "tsc -p tsconfig.review.json",
    "test:review": "vitest run --config vitest.review.config.ts",
    "test:review:db": "node --import tsx evaluation/review/run-db-tests.ts",
    "test:review:e2e": "playwright test --config playwright.review.config.ts",
    "test:review:smoke": "node --import tsx evaluation/review/smoke.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unglish/word-generator.git"
  },
  "keywords": [
    "unglish",
    "word",
    "generator",
    "phonology"
  ],
  "author": "depatchedmode <depatchedmode@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/unglish/word-generator/issues"
  },
  "homepage": "https://github.com/unglish/word-generator#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.11.16",
    "concurrently": "^8.2.2",
    "eslint": "^10.0.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.3.0",
    "prettier": "^2.0.0",
    "supabase": "^2.116.0",
    "tsx": "^4.21.0",
    "typescript": "^4.9.5",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
